# Secrets only. Copy to .env (never commit it).
NOTION_TOKEN=
PSR_SECRET=
OPENROUTER_API_KEY=
SHIFT_SECRET=
# t6 API: every read (Contacts, Projects, Job Orders, Meeting Notes, notices). Both are required.
# The key needs the unmasked read grant. NOTION_TOKEN is only for the Minutes writes.
T6_API_URL=
T6_API_SECRET=

# Optional Tailscale sidecar (compose.tailscale.yaml): its enrollment key does NOT go here.
# Put TS_AUTHKEY=<key> in a separate .env.tailscale (mode 0600), loaded only into the sidecar.
# See "Tailnet and gateway networking" in the README.
